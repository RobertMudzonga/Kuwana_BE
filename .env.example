# ========================
# APPLICATION
# ========================
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME="Sosa Connect API"

# ========================
# DATABASE
# ========================
DATABASE_URL="postgresql://sosa_user:sosa_password@postgres:5432/sosa_connect?schema=public"
# PostGIS extension is enabled via init script

# ========================
# JWT
# ========================
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# BCRYPT
# ========================
BCRYPT_SALT_ROUNDS=12

# ========================
# CORS
# ========================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX=20

# ========================
# STRIPE (Payment Gateway)
# ========================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# ========================
# PAYNOW (Zimbabwe Gateway — stub)
# ========================
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key
PAYNOW_RESULT_URL=http://localhost:3000/api/v1/payments/paynow/callback
PAYNOW_RETURN_URL=http://localhost:3000/api/v1/payments/paynow/return

# ========================
# ACTIVE PAYMENT GATEWAY
# paynow (EcoCash, OneMoney, card) | stripe (card only) | mock (dev only: every payment succeeds)
# ========================
ACTIVE_PAYMENT_GATEWAY=mock

# Paynow test mode only accepts the merchant account's own email as the payer email
PAYNOW_MERCHANT_EMAIL=
# Unpaid checkouts are cancelled (and stock released) after this many minutes
PENDING_PAYMENT_TIMEOUT_MINUTES=30

# ========================
# PUBLIC URLS
# ========================
# Public base URL of this API. Paynow posts results to {PUBLIC_API_URL}/api/v1/payments/paynow/result,
# so in production this must be reachable from the internet (https).
PUBLIC_API_URL=http://localhost:3000
# Password reset links: {APP_URL}/reset-password?token=...  (kuwana:// opens the app)
APP_URL=kuwana://

# ========================
# FILE STORAGE
# ========================
# local = save to ./uploads and serve from this API | minio = MinIO / S3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Public URL prefix for MinIO objects (e.g. a CDN). Defaults to http(s)://MINIO_ENDPOINT:PORT/BUCKET
MINIO_PUBLIC_URL=

# ========================
# SMS (phone verification)
# ========================
# console (dev: codes are written to the log) | twilio | africastalking
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# ========================
# EMAIL (password reset)
# ========================
# Without SMTP_HOST, emails are written to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Kuwana <no-reply@kuwana.co.zw>

# ========================
# PUSH NOTIFICATIONS
# ========================
# Only needed if "enhanced push security" is enabled on the Expo project
EXPO_ACCESS_TOKEN=

# ========================
# MINIO (Object Storage)
# ========================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sosa_minio_access
MINIO_SECRET_KEY=sosa_minio_secret
MINIO_BUCKET_NAME=sosa-connect

# ========================
# LOGGING
# ========================
LOG_LEVEL=info
# debug | info | warn | error

# ========================
# ADMIN DEFAULTS (seed only)
# ========================
ADMIN_EMAIL=admin@sosaconnect.zw
ADMIN_PASSWORD=Admin@Sosa2024!
