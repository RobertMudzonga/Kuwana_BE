# ========================
# APPLICATION
# ========================
NODE_ENV=development
PORT=3000
API_VERSION=v1
APP_NAME="Sosa Connect API"

# ========================
# DATABASE
# ========================
DATABASE_URL="postgresql://sosa_user:sosa_password@localhost:5433/sosa_connect?schema=public"
# PostGIS extension is enabled via init script

# ========================
# JWT
# ========================
JWT_ACCESS_SECRET=a_very_secure_secret_for_sosa_connect_access_32
JWT_REFRESH_SECRET=a_very_secure_secret_for_sosa_connect_refresh_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ========================
# BCRYPT
# ========================
BCRYPT_SALT_ROUNDS=12

# ========================
# CORS
# ========================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081,http://localhost:19006,http://localhost:19000,http://127.0.0.1:3000,http://127.0.0.1:19006

# ========================
# RATE LIMITING
# ========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ========================
# STRIPE (Payment Gateway)
# ========================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# ========================
# PAYNOW (Zimbabwe Gateway — stub)
# ========================
PAYNOW_INTEGRATION_ID=your_paynow_integration_id
PAYNOW_INTEGRATION_KEY=your_paynow_integration_key
PAYNOW_RESULT_URL=http://localhost:3000/api/v1/payments/paynow/callback
PAYNOW_RETURN_URL=http://localhost:3000/api/v1/payments/paynow/return

# ========================
# ACTIVE PAYMENT GATEWAY
# stripe | paynow
# ========================
ACTIVE_PAYMENT_GATEWAY=stripe

# ========================
# MINIO (Object Storage)
# ========================
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sosa_minio_access
MINIO_SECRET_KEY=sosa_minio_secret
MINIO_BUCKET_NAME=sosa-connect

# ========================
# LOGGING
# ========================
LOG_LEVEL=info
# debug | info | warn | error

# ========================
# ADMIN DEFAULTS (seed only)
# ========================
ADMIN_EMAIL=admin@sosaconnect.zw
ADMIN_PASSWORD=Admin@Sosa2024!
